{
  "name": "workspace-ui",
  "version": "0.0.1",
  "description": "UI for workspaces",
  "productName": "Workspace UI",
  "author": "mpr <mroesel@roesel.at>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "dev": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "shell": "python3 -m http.server 8181 -d ../luigi-shell/standalone",
    "shell+dev": "concurrently -k -n SHELL,QUASAR -c cyan,magenta \"npm:shell\" \"npm:dev\""
  },
  "dependencies": {
    "@luigi-project/client": "^2.33.0",
    "@quasar/extras": "^2.1.0",
    "axios": "^1.2.1",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^2.3.0",
    "@types/node": "^26.6.6",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.2",
    "vite-plugin-checker": "^1.0.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^22.23.5",
    "npm": "^10.9.9"
  },
  "packageManager": "npm@10.9.9"
}
