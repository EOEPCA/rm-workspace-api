{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (EOEPCA)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "KUBECONFIG": "${env:HOME}/.kube/config-eoepca-demo",
                "PREFIX_FOR_NAME": "ws",
                "UI_MODE": "ui",
                "SESSION_MODE": "auto",
                "AUTH_MODE": "gateway",
                "AUTH_DEBUG": "true",
                "AUTH_AUDIENCE": "workspace-api"
            },
            "args": [
                "workspace_api:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8181",
                "--log-level",
                "info"
            ]
        },
        {
            "name": "Debug (Versioneer)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "KUBECONFIG": "${env:HOME}/.kube/config-k",
                "PREFIX_FOR_NAME": "s",
                "UI_MODE": "ui",
                "SESSION_MODE": "auto",
                "AUTH_MODE": "gateway",
                "AUTH_DEBUG": "true",
                "AUTH_AUDIENCE": "workspace-api"
            },
            "args": [
                "workspace_api:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8181",
                "--log-level",
                "info"
            ]
        }
    ]
}
